# Supabase 项目配置（Project Settings → API Keys 里复制）
NEXT_PUBLIC_SUPABASE_URL=https://你的ProjectID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx 或 eyJ...（anon public key）
NEXT_PUBLIC_SUPABASE_BUCKET=nail-images
ADMIN_EMAIL=站主邮箱

# 本地开发走代理访问 supabase.co（端口以代理客户端当前 HTTP 端口为准）
# SUPABASE_PROXY_URL=http://127.0.0.1:7890

# 可选：本机快速登录密码（须与 Supabase 账号密码一致）。
# 只配在本地 .env.local，线上不要配 —— 配了登录页就会出现一键登录按钮。
# ADMIN_QUICK_PASSWORD=
